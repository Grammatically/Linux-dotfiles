{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "auto", // Logo type: auto, builtin, small, file, etc.
    "source": "~/.cache/fastfetch/images/logo.png", // Built-in logo name or file path
    "width": 35 // Width in characters
  },

  "display": {
    "separator": "->   ",
    "color": {
      "separator": "1" // Bold
    },
    "constants": [
      "────────────────────"
    ],
    "key": {
      "type": "both",
      "paddingLeft": 4
    }
  },
  
  "modules": [
    {
      "type": "custom",
      "format": "┌{$1} {#1}System Information{#} {$1}┐"
    },
    {
      "key": "OS           ",
      "keyColor": "red",
      "type": "os"
    },
    {
      "key": "Machine      ",
      "keyColor": "red",
      "type": "host"
    },
    {
      "key": "Kernel       ",
      "keyColor": "red",
      "type": "kernel"
    },
    {
      "key": "Local IP     ",
      "keyColor": "red",
      "type": "localip",
      "compact": true
    },
        {
      "key": "WM           ",
      "keyColor": "red",
      "type": "wm"
    },
    {
      "key": "Uptime       ",
      "keyColor": "magenta",
      "type": "uptime"
    },
    {
      "key": "Resolution   ",
      "keyColor": "magenta",
      "type": "display",
      "compactType": "original-with-refresh-rate"
    },
    {
      "key": "DE           ",
      "keyColor": "magenta",
      "type": "de"
    },
    {
      "key": "Shell        ",
      "keyColor": "magenta",
      "type": "shell"
    },
    {
      "key": "Terminal     ",
      "keyColor": "magenta",
      "type": "terminal"
    },
    {
      "key": "CPU          ",
      "keyColor": "yellow",
      "type": "cpu"
    },
    {
      "key": "GPU          ",
      "keyColor": "yellow",
      "type": "gpu"
    },
    {
      "key": "Memory       ",
      "keyColor": "yellow",
      "type": "memory"
    },
    "break",
    {
      "type": "custom",
      "format": "└{$1}────────────────────{$1}┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 22,
      "symbol": "circle"
    }
  ]
}